<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="دليل شامل لدورة حياة عمليات النقل في نظام كوديفاي: الجداول الزمنية، التعيينات، توليد الرحلات، ومراجعة الجاهزية.">
    <meta name="theme-color" content="#2563eb">
    <title>دليل نظام كوديفاي - إدارة النقل المتقدمة</title>

    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Mermaid JS for Flowcharts -->
    <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
    <script>
        mermaid.initialize({
            startOnLoad: true,
            theme: 'base',
            securityLevel: 'loose',
            themeVariables: {
                primaryColor: '#eff6ff',
                primaryTextColor: '#1e3a8a',
                primaryBorderColor: '#3b82f6',
                lineColor: '#94a3b8',
                fontFamily: 'Cairo, sans-serif'
            }
        });
    </script>

    <style>
        /* ---------- Custom Scrollbar ---------- */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* ---------- Typography ---------- */
        body {
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }

        /* ---------- Image Hover & Lightbox Cursor ---------- */
        .lightbox-trigger {
            cursor: zoom-in;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .lightbox-trigger:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, .1), 0 8px 10px -6px rgba(0, 0, 0, .1);
        }

        /* ---------- Anchor offset for headings ---------- */
        .prose h2,
        section[id] {
            scroll-margin-top: 6rem;
        }

        /* ---------- Mermaid SVG ---------- */
        .mermaid svg {
            max-width: 100%;
            height: auto;
        }

        /* ---------- Focus visibility (a11y) ---------- */
        a:focus-visible,
        button:focus-visible {
            outline: 2px solid #2563eb;
            outline-offset: 2px;
            border-radius: 6px;
        }

        /* ---------- Back-to-top reveal ---------- */
        #back-to-top.is-visible {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }

        /* ---------- Print ---------- */
        @media print {

            aside,
            #mobile-header,
            #lightbox,
            #back-to-top,
            #scroll-progress {
                display: none !important;
            }

            main {
                margin: 0 !important;
                max-width: 100% !important;
            }
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800 antialiased selection:bg-primary-100 selection:text-primary-900">

    <!-- ============ Scroll Progress Bar ============ -->
    <div id="scroll-progress"
        class="fixed top-0 start-0 z-[60] h-1 w-0 bg-gradient-to-l from-primary-500 to-primary-700 transition-[width] duration-150 ease-out">
    </div>

    <!-- ============ Mobile Header ============ -->
    <div id="mobile-header"
        class="sticky top-0 z-40 flex h-16 items-center justify-between border-b border-slate-200 bg-white/90 px-4 backdrop-blur-md lg:hidden">
        <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded bg-primary-600 text-white">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
            </div>
            <span class="text-xl font-bold text-slate-900">كوديفاي</span>
        </div>

        <button id="mobile-menu-btn" type="button" aria-label="فتح القائمة" aria-controls="sidebar"
            aria-expanded="false" class="text-slate-500 hover:text-slate-700 focus:outline-none p-2 rounded-lg">
            <!-- Hamburger -->
            <svg id="icon-menu" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Close -->
            <svg id="icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <!-- ============ Sidebar ============ -->
    <!--
        ملاحظة RTL: في وضع dir="rtl" فإن start = يمين و end = يسار.
        الشريط الجانبي مثبّت على اليمين (start-0) وهو الموضع الطبيعي للتوثيق العربي.
    -->
    <aside id="sidebar"
        class="fixed inset-y-0 start-0 z-50 flex w-72 translate-x-full transform flex-col overflow-y-auto border-e border-slate-200 bg-white pt-5 pb-10 transition-transform duration-300 ease-in-out lg:translate-x-0 lg:pt-8"
        aria-label="قائمة التنقل الرئيسية">

        <!-- Brand -->
        <div class="px-6 mb-8 hidden lg:flex items-center gap-3">
            <div
                class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 text-white shadow-md shadow-primary-500/20">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
            </div>
            <span class="text-2xl font-bold text-slate-900">كوديفاي<span class="text-primary-600">.</span></span>
        </div>

        <!-- Nav -->
        <nav class="px-4 text-sm font-medium flex-1" id="nav-menu">
            <ul class="space-y-8">
                <li>
                    <h2 class="font-bold text-slate-900 px-3 mb-3 uppercase tracking-widest text-xs">توثيق النقل</h2>
                    <ul class="space-y-1 border-s border-slate-100 ms-3 ps-3">
                        <li>
                            <a href="#intro"
                                class="nav-link block rounded-md px-3 py-2 text-slate-600 hover:bg-slate-50 hover:text-primary-600 transition-colors">مقدمة
                                دورة النقل</a>
                        </li>
                        <li>
                            <a href="#schedule-vs-assignment"
                                class="nav-link block rounded-md px-3 py-2 text-slate-600 hover:bg-slate-50 hover:text-primary-600 transition-colors">الجدول
                                مقابل التعيين</a>
                        </li>
                        <li>
                            <a href="#cycle-workflow"
                                class="nav-link block rounded-md px-3 py-2 text-slate-600 hover:bg-slate-50 hover:text-primary-600 transition-colors">من
                                الجدول إلى الرحلة</a>
                        </li>
                        <li>
                            <a href="#readiness"
                                class="nav-link block rounded-md px-3 py-2 text-slate-600 hover:bg-slate-50 hover:text-primary-600 transition-colors">مراجعة
                                الجاهزية</a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>

        <!-- Sidebar footer -->
        <div class="px-6 mt-8 pt-6 border-t border-slate-100">
            <p class="text-xs text-slate-400 leading-relaxed">
                إصدار التوثيق <span class="font-bold text-slate-500">2.4</span><br>
                © كوديفاي — جميع الحقوق محفوظة.
            </p>
        </div>
    </aside>

    <!-- Sidebar overlay (mobile) -->
    <div id="sidebar-overlay"
        class="fixed inset-0 z-40 hidden bg-slate-900/50 backdrop-blur-sm transition-opacity lg:hidden"></div>

    <!-- ============ Main Content ============ -->
    <main class="mx-auto max-w-5xl px-4 pt-10 pb-24 sm:px-6 lg:px-8 lg:ms-72">

        <!-- ===== Header ===== -->
        <header class="mb-16">
            <div
                class="inline-flex items-center rounded-full bg-primary-50 px-3 py-1 text-sm font-medium text-primary-700 mb-4 ring-1 ring-inset ring-primary-700/10">
                إصدار 2.4 — التوثيق الرسمي
            </div>
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4">
                دليل التشغيل وإدارة النقل
            </h1>
            <p class="text-lg text-slate-600 leading-relaxed max-w-3xl">
                دليل شامل يغطي دورة حياة عمليات النقل في كوديفاي، من تخطيط الجداول وتعيين الموارد إلى توليد الرحلات
                وتقييم جاهزية المشاريع للانطلاق.
            </p>
        </header>

        <div class="prose max-w-none">

            <!-- ================= SECTION 1 ================= -->
            <section id="intro" class="mb-20 scroll-mt-24">
                <div class="flex items-center gap-3 mb-6">
                    <div class="h-8 w-1 rounded bg-primary-500"></div>
                    <h2 class="text-3xl font-bold text-slate-900 m-0">1. مقدمة دورة النقل</h2>
                </div>

                <p class="text-slate-600 text-lg mb-8 leading-relaxed">
                    تبدأ عمليات النقل بتعريف المشروع والمسارات، ثم وضع الجداول الزمنية التي تحدد "متى" و"أين" تعمل
                    المركبات. الرسم البياني والصور أدناه توضح هذه الدورة.
                </p>

                <div class="grid grid-cols-1 gap-8 mb-8">

                    <!-- Flow diagram -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <h3 class="text-lg font-bold text-slate-800 mb-4">التدفق المنطقي للعمليات</h3>
                        <div class="mermaid flex justify-center" dir="ltr">
                            graph LR
                            A["مشروع النقل"] --> B["المسارات والخطوط"]
                            B --> C["الجداول الزمنية"]
                            C --> D["تعيين الموارد"]
                            D --> E["توليد الرحلات اليومية"]
                            style A fill:#eff6ff,stroke:#3b82f6,stroke-width:2px
                            style E fill:#f0fdf4,stroke:#22c55e,stroke-width:2px
                        </div>
                    </div>

                    <!-- Image cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <!-- Card 1 : Workflow -->
                        <figure
                            class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden group m-0">
                            <div class="aspect-video bg-slate-100 overflow-hidden relative">
                                <img src="/CodefyERP-Help/Code/Statics/img/workfllow.jpg"
                                    alt="سير العمل العام: من الجدول إلى الرحلة"
                                    class="lightbox-trigger object-cover w-full h-full" loading="lazy" decoding="async"
                                    onerror="this.onerror=null;this.src='https://placehold.co/800x450/e2e8f0/475569?text=Image+Not+Found'">
                                <div
                                    class="absolute inset-0 bg-primary-900/0 group-hover:bg-primary-900/10 transition-colors pointer-events-none">
                                </div>
                            </div>
                            <figcaption class="p-4 border-t border-slate-100">
                                <h4 class="font-bold text-slate-900 text-sm">سير العمل العام (Overall Workflow)</h4>
                                <p class="text-xs text-slate-500 mt-1">توضيح مبدئي لدورة تحول الخطة إلى رحلة فعلية.</p>
                            </figcaption>
                        </figure>

                        <!-- Card 2 : System cycle -->
                        <figure
                            class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden group m-0">
                            <div class="aspect-video bg-slate-100 overflow-hidden relative">
                                <img src="/CodefyERP-Help/Code/Statics/img/workfllow1.jpg"
                                    alt="دورة نظام كوديفاي وتخصيص الجداول"
                                    class="lightbox-trigger object-cover w-full h-full" loading="lazy" decoding="async"
                                    onerror="this.onerror=null;this.src='https://placehold.co/800x450/e2e8f0/475569?text=Image+Not+Found'">
                                <div
                                    class="absolute inset-0 bg-primary-900/0 group-hover:bg-primary-900/10 transition-colors pointer-events-none">
                                </div>
                            </div>
                            <figcaption class="p-4 border-t border-slate-100">
                                <h4 class="font-bold text-slate-900 text-sm">دورة نظام كوديفاي للتشغيل</h4>
                                <p class="text-xs text-slate-500 mt-1">كيفية تفاعل الجداول وتخصيصاتها داخل النظام
                                    الأساسي.</p>
                            </figcaption>
                        </figure>

                    </div>
                </div>
            </section>

            <!-- ================= SECTION 2 ================= -->
            <section id="schedule-vs-assignment" class="mb-20 scroll-mt-24">
                <div class="flex items-center gap-3 mb-6">
                    <div class="h-8 w-1 rounded bg-indigo-500"></div>
                    <h2 class="text-3xl font-bold text-slate-900 m-0">2. الفرق بين الجدول وتعيين الجدول</h2>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">

                    <!-- Schedule -->
                    <div
                        class="bg-gradient-to-br from-indigo-50 to-white p-6 rounded-2xl border border-indigo-100 relative overflow-hidden">
                        <div class="absolute top-0 end-0 -mt-4 -me-4 text-indigo-100 opacity-50 pointer-events-none"
                            aria-hidden="true">
                            <svg class="h-32 w-32" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-indigo-900 mb-3 relative z-10">الجدول (Schedule)</h3>
                        <p class="text-indigo-700 font-medium text-sm mb-4 relative z-10">الخطة الزمنية المجردة</p>
                        <ul class="space-y-2 text-slate-700 text-sm relative z-10 font-medium">
                            <li class="flex gap-2 items-start"><span class="text-indigo-500 mt-1">✔</span> يحدد "متى"
                                تعمل الرحلة (أيام الأسبوع، وقت الانطلاق).</li>
                            <li class="flex gap-2 items-start"><span class="text-indigo-500 mt-1">✔</span> يرتبط بالمسار
                                والمحطات.</li>
                            <li class="flex gap-2 items-start"><span class="text-indigo-500 mt-1">✔</span> لا يحتوي على
                                بيانات السائق أو المركبة.</li>
                        </ul>
                    </div>

                    <!-- Assignment -->
                    <div
                        class="bg-gradient-to-br from-emerald-50 to-white p-6 rounded-2xl border border-emerald-100 relative overflow-hidden">
                        <div class="absolute top-0 end-0 -mt-4 -me-4 text-emerald-100 opacity-50 pointer-events-none"
                            aria-hidden="true">
                            <svg class="h-32 w-32" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-emerald-900 mb-3 relative z-10">التعيين (Assignment)</h3>
                        <p class="text-emerald-700 font-medium text-sm mb-4 relative z-10">التنفيذ العملي للخطة</p>
                        <ul class="space-y-2 text-slate-700 text-sm relative z-10 font-medium">
                            <li class="flex gap-2 items-start"><span class="text-emerald-500 mt-1">✔</span> يحدد "من"
                                سينفذ الرحلة.</li>
                            <li class="flex gap-2 items-start"><span class="text-emerald-500 mt-1">✔</span> يربط الجدول
                                بالسائق، المركبة، أو المورد (Supplier).</li>
                            <li class="flex gap-2 items-start"><span class="text-emerald-500 mt-1">✔</span> يمتلك تاريخ
                                صلاحية (بداية ونهاية).</li>
                        </ul>
                    </div>

                </div>

                <!-- Reference image -->
                <figure class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden m-0">
                    <div class="p-4 border-b border-slate-100 bg-slate-50 flex items-center gap-2">
                        <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                            aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                        </svg>
                        <h4 class="font-bold text-slate-800 text-sm">إنشاء ارتباط عام (Reusable Unit)</h4>
                    </div>
                    <img src="11.png" alt="Creating a general association - Reusable unit"
                        class="lightbox-trigger w-full h-auto max-h-[400px] object-cover object-top" loading="lazy"
                        decoding="async"
                        onerror="this.onerror=null;this.src='https://placehold.co/800x400/e2e8f0/475569?text=Image+Not+Found'">
                    <figcaption class="p-4 bg-white text-sm text-slate-600 border-t border-slate-100">
                        توضح الصورة كيفية تكوين وحدة قابلة لإعادة الاستخدام لربط الجداول بالموارد بسهولة.
                    </figcaption>
                </figure>
            </section>

            <!-- ================= SECTION 3 ================= -->
            <section id="cycle-workflow" class="mb-20 scroll-mt-24">
                <div class="flex items-center gap-3 mb-6">
                    <div class="h-8 w-1 rounded bg-amber-500"></div>
                    <h2 class="text-3xl font-bold text-slate-900 m-0">3. دورة العمل: من الجدول إلى الرحلة</h2>
                </div>

                <p class="text-slate-600 text-lg mb-8 leading-relaxed">
                    هذه المرحلة هي الجوهر التشغيلي، حيث يقوم النظام بقراءة <strong>الجداول</strong> و
                    <strong>التعيينات</strong> لإنشاء السجلات التنفيذية اليومية المعروفة بـ
                    <strong>الرحلات (Trips)</strong>. الشاشات التالية تستعرض هذه الخطوات عملياً.
                </p>

                <div class="space-y-8">

                    <!-- Dashboard -->
                    <figure class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden m-0">
                        <div class="p-5 border-b border-slate-100">
                            <h4 class="font-bold text-slate-900 text-lg">لوحة القيادة (Dashboard): الأسطول والتعيينات
                            </h4>
                            <p class="text-sm text-slate-500 mt-1">نظرة عامة على حالة الأسطول وتخصيصات الجداول
                                الحالية.</p>
                        </div>
                        <img src="10_2.png" alt="Dashboard: Fleet and Schedule Assignments"
                            class="lightbox-trigger w-full h-auto" loading="lazy" decoding="async"
                            onerror="this.onerror=null;this.src='https://placehold.co/1000x500/e2e8f0/475569?text=Dashboard+Image'">
                    </figure>

                    <!-- Planning -->
                    <figure class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden m-0">
                        <div class="p-5 border-b border-slate-100">
                            <h4 class="font-bold text-slate-900 text-lg">التخطيط (Planning): تعيين الجداول للمسارات
                            </h4>
                            <p class="text-sm text-slate-500 mt-1">شاشة واجهة التخطيط لربط الجداول بالمسارات المطلوبة.
                            </p>
                        </div>
                        <img src="10r.png" alt="Planning: Schedule Assignments for routes"
                            class="lightbox-trigger w-full h-auto" loading="lazy" decoding="async"
                            onerror="this.onerror=null;this.src='https://placehold.co/1000x500/e2e8f0/475569?text=Planning+Image'">
                    </figure>

                    <!-- Assignment editing -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <figure class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden m-0">
                            <div class="p-4 border-b border-slate-100">
                                <h4 class="font-bold text-slate-900 text-sm">تعديل/إنشاء التعيينات (1)</h4>
                            </div>
                            <img src="10rrl.png" alt="Modifying assignments for routes part 1"
                                class="lightbox-trigger w-full h-auto max-h-[300px] object-cover object-top"
                                loading="lazy" decoding="async"
                                onerror="this.onerror=null;this.src='https://placehold.co/600x300/e2e8f0/475569?text=Assignment+Part+1'">
                        </figure>

                        <figure class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden m-0">
                            <div class="p-4 border-b border-slate-100">
                                <h4 class="font-bold text-slate-900 text-sm">تعديل/إنشاء التعيينات (2)</h4>
                            </div>
                            <img src="10r2rl.png" alt="Modifying assignments for routes part 2"
                                class="lightbox-trigger w-full h-auto max-h-[300px] object-cover object-top"
                                loading="lazy" decoding="async"
                                onerror="this.onerror=null;this.src='https://placehold.co/600x300/e2e8f0/475569?text=Assignment+Part+2'">
                        </figure>

                    </div>
                </div>
            </section>

            <!-- ================= SECTION 4 ================= -->
            <section id="readiness" class="mb-20 scroll-mt-24">
                <div class="flex items-center gap-3 mb-6">
                    <div class="h-8 w-1 rounded bg-rose-500"></div>
                    <h2 class="text-3xl font-bold text-slate-900 m-0">4. مراجعة جاهزية مشروع النقل</h2>
                </div>

                <p class="text-slate-600 mb-6 leading-relaxed">
                    تُعرف مراجعة الجاهزية بأنها عملية التحقق مما إذا كان مشروع النقل جاهزاً لبدء التشغيل في تاريخ محدد
                    (Pre-go-live). قد يكون المشروع نشطاً، لكنه لا يُعتبر "جاهزاً زمنياً" ما لم تتوفر الشروط التالية في
                    تاريخ التشغيل المستهدف.
                </p>

                <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm bg-white">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm text-start">
                            <caption class="sr-only">جدول مراجعة جاهزية مشروع النقل</caption>
                            <thead class="bg-slate-50 border-b border-slate-200 text-slate-900 font-bold">
                                <tr>
                                    <th scope="col" class="px-6 py-4 text-start whitespace-nowrap">منطقة المراجعة
                                        (Area)</th>
                                    <th scope="col" class="px-6 py-4 text-start">سؤال الجاهزية (Readiness Question)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-slate-700">
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">حالة المشروع
                                    </td>
                                    <td class="px-6 py-4">هل مشروع النقل نشط ومعتمد (Active/Approved)؟</td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">تواريخ العقد
                                    </td>
                                    <td class="px-6 py-4">هل يقع تاريخ الخدمة ضمن فترة صلاحية المشروع أو العقد؟</td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">المسارات</td>
                                    <td class="px-6 py-4">هل تم إنشاء المسارات والخطوط المطلوبة وهي في حالة نشطة؟</td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">الجداول</td>
                                    <td class="px-6 py-4">هل تم تكوين جداول زمنية لأيام وأوقات التشغيل المحددة؟</td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">التعيينات</td>
                                    <td class="px-6 py-4">هل الجداول مُسندة فعلياً لمورد، مركبة، سائق، أو الموارد
                                        المطلوبة للتشغيل؟</td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">التسعير</td>
                                    <td class="px-6 py-4">هل تم إعداد أسعار التوريد والبيع إذا كانت الفوترة وحساب
                                        التكاليف مطلوبة؟</td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">السعة</td>
                                    <td class="px-6 py-4">هل المركبات المعينة ملائمة لحجم الركاب ومتطلبات الخط؟</td>
                                </tr>
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">الاستثناءات
                                    </td>
                                    <td class="px-6 py-4">هل تم معالجة العطلات، أيام الإيقاف، التواريخ المحظورة، أو
                                        التغييرات الخاصة؟</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

        </div>
    </main>

    <!-- ============ Back to top ============ -->
    <button id="back-to-top" type="button" aria-label="العودة إلى الأعلى"
        class="fixed bottom-6 end-6 z-40 flex h-11 w-11 items-center justify-center rounded-full bg-primary-600 text-white shadow-lg shadow-primary-600/30 opacity-0 translate-y-3 pointer-events-none transition-all duration-300 hover:bg-primary-700 focus:outline-none">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
    </button>

    <!-- ============ Lightbox Modal ============ -->
    <div id="lightbox" role="dialog" aria-modal="true" aria-label="عرض الصورة بالحجم الكامل"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/90 backdrop-blur-sm opacity-0 transition-opacity duration-300">
        <button id="lightbox-close" type="button" aria-label="إغلاق"
            class="absolute top-6 end-6 text-white hover:text-slate-300 focus:outline-none p-2 bg-slate-800/50 hover:bg-slate-800/80 rounded-full transition-colors">
            <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <div class="max-w-5xl max-h-screen p-4 w-full flex justify-center items-center">
            <img id="lightbox-img" src="" alt="عرض مكبّر"
                class="max-w-full max-h-[90vh] rounded-lg shadow-2xl object-contain transform scale-95 transition-transform duration-300">
        </div>
    </div>

    <!-- ============ Scripts ============ -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            /* =========================================================
               1) Mobile Sidebar Toggle
               ========================================================= */
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebar-overlay');
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const iconMenu = document.getElementById('icon-menu');
            const iconClose = document.getElementById('icon-close');
            const navLinks = document.querySelectorAll('.nav-link');

            const isSidebarOpen = () => !sidebar.classList.contains('translate-x-full');

            function openSidebar() {
                sidebar.classList.remove('translate-x-full');
                sidebarOverlay.classList.remove('hidden');
                mobileMenuBtn.setAttribute('aria-expanded', 'true');
                iconMenu.classList.add('hidden');
                iconClose.classList.remove('hidden');
            }

            function closeSidebar() {
                sidebar.classList.add('translate-x-full');
                sidebarOverlay.classList.add('hidden');
                mobileMenuBtn.setAttribute('aria-expanded', 'false');
                iconMenu.classList.remove('hidden');
                iconClose.classList.add('hidden');
            }

            function toggleSidebar() {
                isSidebarOpen() ? closeSidebar() : openSidebar();
            }

            if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', toggleSidebar);
            if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);

            // Close after clicking a nav link (mobile only)
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    if (window.innerWidth < 1024 && isSidebarOpen()) closeSidebar();
                });
            });

            // Reset state when resizing to desktop
            window.addEventListener('resize', () => {
                if (window.innerWidth >= 1024) {
                    sidebarOverlay.classList.add('hidden');
                    iconMenu.classList.remove('hidden');
                    iconClose.classList.add('hidden');
                    mobileMenuBtn.setAttribute('aria-expanded', 'false');
                }
            });

            /* =========================================================
               2) ScrollSpy — active nav link
               ========================================================= */
            const sections = Array.from(document.querySelectorAll('main section[id]'));

            function updateActiveLink() {
                const scrollPos = window.scrollY;
                let current = '';

                sections.forEach(section => {
                    if (scrollPos >= section.offsetTop - 160) {
                        current = section.id;
                    }
                });

                navLinks.forEach(link => {
                    link.classList.remove('text-primary-700', 'bg-primary-50', 'font-bold');
                    if (link.getAttribute('href') === `#${current}`) {
                        link.classList.add('text-primary-700', 'bg-primary-50', 'font-bold');
                    }
                });
            }

            /* =========================================================
               3) Scroll progress bar + back-to-top visibility
               ========================================================= */
            const progressBar = document.getElementById('scroll-progress');
            const backToTop = document.getElementById('back-to-top');

            function onScroll() {
                const scrollTop = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const percent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;

                if (progressBar) progressBar.style.width = percent + '%';

                if (backToTop) {
                    backToTop.classList.toggle('is-visible', scrollTop > 500);
                }

                updateActiveLink();
            }

            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll(); // run once on load

            if (backToTop) {
                backToTop.addEventListener('click', () => {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            /* =========================================================
               4) Lightbox
               ========================================================= */
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightbox-img');
            const lightboxClose = document.getElementById('lightbox-close');
            const triggers = document.querySelectorAll('.lightbox-trigger');
            let lastFocused = null;

            function openLightbox(src, altText) {
                lastFocused = document.activeElement;
                lightboxImg.src = src;
                lightboxImg.alt = altText || 'عرض مكبّر';

                lightbox.classList.remove('hidden');
                lightbox.classList.add('flex');
                void lightbox.offsetWidth; // force reflow

                lightbox.classList.remove('opacity-0');
                lightboxImg.classList.remove('scale-95');
                lightboxImg.classList.add('scale-100');

                document.body.style.overflow = 'hidden';
                lightboxClose.focus();
            }

            function closeLightbox() {
                lightbox.classList.add('opacity-0');
                lightboxImg.classList.remove('scale-100');
                lightboxImg.classList.add('scale-95');

                setTimeout(() => {
                    lightbox.classList.add('hidden');
                    lightbox.classList.remove('flex');
                    lightboxImg.src = '';
                    document.body.style.overflow = '';
                    if (lastFocused) lastFocused.focus();
                }, 300);
            }

            triggers.forEach(img => {
                img.addEventListener('click', (e) => {
                    e.preventDefault();
                    openLightbox(img.src, img.alt);
                });
            });

            if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);

            if (lightbox) {
                lightbox.addEventListener('click', (e) => {
                    if (e.target === lightbox) closeLightbox();
                });
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
                    closeLightbox();
                }
            });

            /* =========================================================
               5) Fallback for broken images (keeps the placeholder)
               ========================================================= */
            document.querySelectorAll('img').forEach(img => {
                img.addEventListener('error', () => {
                    if (!img.dataset.fallbackApplied) {
                        img.dataset.fallbackApplied = 'true';
                        img.src = 'https://placehold.co/800x450/e2e8f0/475569?text=Image+Not+Found';
                    }
                });
            });

        });
    </script>
</body>

</html>