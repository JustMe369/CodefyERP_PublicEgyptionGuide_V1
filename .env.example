# Copy to .env for local XAMPP + PostgreSQL development.
# Replace every password before starting PostgreSQL.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=codefy_guide
PGUSER=codefy_app
PGPASSWORD=replace-with-a-long-random-runtime-password
POSTGRES_PASSWORD=replace-with-a-different-long-owner-password

# For Supabase transaction-pooler connections (port 6543), set sslmode=require
# and CODEFY_PDO_EMULATE_PREPARES=true. Keep credentials in .env, never in source.
# CODEFY_DATABASE_DSN=pgsql:host=aws-1-eu-west-1.pooler.supabase.com;port=6543;dbname=postgres;sslmode=require
# CODEFY_PDO_EMULATE_PREPARES=true

# Set these only for the one-time admin account creation command, not in this file.
# CODEFY_ADMIN_EMAIL=admin@example.com
# CODEFY_ADMIN_NAME=Site Administrator
# CODEFY_ADMIN_PASSWORD=use-a-unique-password-at-least-14-characters
